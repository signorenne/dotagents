{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(cmake --preset *)",
      "Bash(cmake --build *)",
      "Bash(cmake -B *)",
      "Bash(ctest *)",
      "Bash(clang-format *)",
      "Bash(clang-format-20 *)",
      "Bash(clang-tidy *)",
      "Bash(clang-tidy-20 *)",
      "Bash(./build/*)",
      "Read(~/memex/**)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git update-ref *)",
      "Bash(git -C * update-ref *)",
      "Bash(git merge *)",
      "Bash(git -C * merge *)",
      "Bash(git branch -f *)",
      "Bash(git -C * branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git -C * branch --force *)",
      "Bash(git branch -M *)",
      "Bash(git -C * branch -M *)",
      "Bash(git branch -C *)",
      "Bash(git -C * branch -C *)",
      "Bash(git branch -D *)",
      "Bash(git -C * branch -D *)",
      "Bash(git branch -df *)",
      "Bash(git -C * branch -df *)",
      "Bash(git branch -fd *)",
      "Bash(git -C * branch -fd *)",
      "Bash(git branch -d -f *)",
      "Bash(git -C * branch -d -f *)",
      "Bash(git branch -d --force *)",
      "Bash(git -C * branch -d --force *)",
      "Bash(git branch --delete -f *)",
      "Bash(git -C * branch --delete -f *)",
      "Bash(git branch --delete --force *)",
      "Bash(git -C * branch --delete --force *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git -C * push)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)"
    ]
  },
  "enabledPlugins": {
    "engineering@synced": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/guard_bash.py\" --tool claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/after_edit.py\" --tool claude",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/repeated_failure.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/compact_brief.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/session_refresh.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/progress_check.py\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/claim_check.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
