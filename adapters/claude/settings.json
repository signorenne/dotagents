{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(cmake --preset *)",
      "Bash(cmake --build *)",
      "Bash(cmake -B *)",
      "Bash(ctest *)",
      "Bash(clang-format *)",
      "Bash(clang-format-20 *)",
      "Bash(clang-tidy *)",
      "Bash(clang-tidy-20 *)",
      "Bash(./build/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/guard_bash.py\" --tool claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/after_edit.py\" --tool claude",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/session_refresh.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
