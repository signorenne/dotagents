@startuml arch_skills_specialist
!include palette.iuml
title Where do the specialist skills hand work on?

package "Application design" {
  component "clean-architecture" as clean
  component "qt-quick" as qt
  component "event-driven-ui" as events
}

package "Documents and audits" {
  component "architecture-doc" as archdoc
  component "as-built-docs" as asbuilt
  component "plantuml-diagrams" as puml
  component "precise-ui-changes" as preciseui
  component "code-audit" as audit
}

package "Changes across files" {
  component "mechanical-changes" as mech
  component "parallel-agents" as parallel
  component "isolated-work" as isolated
}

component "systematic-debugging" as debug
component "design" as spec
component "trustworthy-tests" as tests
component "build" as implement

archdoc --> puml
asbuilt --> puml
asbuilt --> preciseui
asbuilt --> audit
archdoc --> spec
clean -right- archdoc
audit --> implement
preciseui --> tests

parallel -- mech
mech --> implement
parallel ---> isolated
isolated --> implement
mech -[hidden]down- isolated

clean -- qt
clean --> events
qt -- events
events -- debug
clean --> spec
clean ---> implement
tests -[hidden]down- implement

legend right
  Solid arrow: hands work to
  Plain line: each names the other
  Outside the packages: skills of the other maps
  Rows marked not drawn: in the table only
endlegend
@enduml
