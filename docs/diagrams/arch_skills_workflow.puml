@startuml arch_skills_workflow
!include palette.iuml
title Which skills and subagents serve each stage of a change?

component "Set up (once): project-setup\nscout, gate-runner" as setup
package "Decide and specify" {
  component "decide" as decide
  component "spec\nscout, reviewer" as spec
}
package "Implement, gates and review" {
  component "implement\nscout, gate-runner, reviewer" as implement
  component "trustworthy-tests" as tests
  component "systematic-debugging" as debug
}
package "On request" {
  component "gates\ngate-runner" as gates
  component "branch-review\nreviewer" as review
}
component "Close: session-close" as close
component "Land and clean up: isolated-work\ngate-runner" as isolated

setup --> decide : open points
spec -right-> decide : design choices
spec ..> implement : spec file
implement -up-> decide : user's choices
implement --> tests : test first
implement --> debug : two failed fixes
close .left.> implement : handoff
implement ---> isolated : worktree,\nlanding
spec -[hidden]right- gates
gates -[hidden]right- review

legend right
  Second line: the subagents it may delegate to
  Solid arrow: calls in the same session
  Dashed arrow: a file read by a fresh session
endlegend
@enduml
