@startuml arch_parts
!include palette.iuml
title What lives in the repository, and what does each part produce?

file "adapters/claude/\nsettings.json" as adapters

package "Shared source" as source {
  package "home/.agents" as home {
    file "Global rules\nAGENTS.md" as rules
    folder "Local skills\nskills/" as skills
    folder "Subagents\nagents/" as agents
    folder "Hooks\nhooks/" as hooks
  }
  package "claude-ai" as online {
    folder "claude.ai set\nskills/" as webskills
    file "Overrides\noverrides.json" as overrides
  }
}
component "install.py" as install
component "tools/build.py" as build

package "Outputs" {
  folder "&#126;/.agents and\neach tool's folder" as installed
  folder "dist/\nzips" as dist
}

node "CI\nci.yml" as ci
component "tools/validate.py" as validate
folder "tests/" as tests

adapters --> install
source --> install
skills --> build
webskills --> build
overrides --> build
install -[hidden]right- build
install ..> installed
build ..> dist

ci -[dotted]-> validate
ci -[dotted]-> tests
ci -[dotted]up-> build

legend right
  Solid arrow: read as input
  Dashed arrow: written as output
  Dotted arrow: run by CI
endlegend
@enduml
